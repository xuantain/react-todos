# Stage 1: Build the application
FROM node:22-alpine as build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# For Create React App use:
# RUN npm run build

# For Vite use:
RUN npm run build

# Stage 2: Serve the application
FROM node:22-alpine

WORKDIR /app
COPY --from=build /app .

# For development with live reload
EXPOSE 3000
CMD ["npm", "run", "dev"]